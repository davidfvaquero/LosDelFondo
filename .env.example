# ── DEPORTEData — Variables de entorno (.env) ────────────────────────────────
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas el .env real a GitHub (está en .gitignore)

# ── AWS ──────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=TU_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=TU_SECRET_KEY
AWS_SESSION_TOKEN=TU_SESSION_TOKEN
AWS_DEFAULT_REGION=us-east-1

# ── S3 ───────────────────────────────────────────────────────────────────────
S3_BUCKET=deportedata-models-data

# ── RDS PostgreSQL ────────────────────────────────────────────────────────────
DB_HOST=deportedata-rds.xxxxxxx.us-east-1.rds.amazonaws.com
DB_NAME=deportedata
DB_USER=deporteadmin
DB_PASSWORD=DeporteData2026!
